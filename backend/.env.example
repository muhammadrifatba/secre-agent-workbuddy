# ==============================================================================
# SEKRE v3 BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. LLM CONFIGURATION (GOOGLE GEMINI OR TENCENT / OPENAI COMPATIBLE)
# Provider option: "auto" (default, prefers Google if GOOGLE_API_KEY is provided), "google", or "tencent"
LLM_PROVIDER=auto

# A. Google Gemini LLM Configuration (Light / Fast Model)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FAST_MODEL=gemini-2.0-flash-lite

# B. Tencent Cloud / OpenAI Compatible Endpoints
TENCENT_LLM_BASE_URL=https://api.tokenhub.tencentcloud.com/v1
TENCENT_LLM_API_KEY=your-tencent-workbuddy-tokenhub-key
PLANNER_MODEL=deepseek-v3
FAST_MODEL=hunyuan-turbo

# Set to true to automatically fallback to deterministic offline mocks if LLM call fails or API key is absent
USE_MOCK_LLM_FALLBACK=true

# 2. CRYPTOGRAPHIC AUDIT LOG
# Secret key used for HMAC-SHA256 tamper-evident log chaining (TR-14)
AUDIT_HMAC_SECRET=sekre-v3-immutable-secret-2026

# 3. OUTBOX QUEUE CONFIGURATION
# Delayed dispatch safety net window in seconds (default: 60)
OUTBOX_DELAY_SECONDS=60

# 4. REAL EMAIL DISPATCH (OPTIONAL)
# By default, emails are safely queued in SQLite as mock without real delivery.
# To send REAL emails after the 60s outbox countdown elapses, configure your SMTP server here:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sekre@nusantara-ab.co.id

# 5. FAST MCP & BACKEND URL
BACKEND_URL=http://127.0.0.1:8000
SEKRE_USE_REMOTE_BACKEND=0

